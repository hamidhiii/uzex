# OpenAI-совместимый эндпоинт с tool calling. Рекомендуемый вариант — OpenRouter (один ключ, все модели, кэш промпта для Claude).
# OpenRouter:  LLM_BASE_URL=https://openrouter.ai/api/v1     LLM_MODEL=anthropic/claude-sonnet-5.5
# Anthropic:   LLM_BASE_URL=https://api.anthropic.com/v1/    LLM_MODEL=claude-sonnet-5-5   LLM_FALLBACK_MODELS=claude-opus-5-5  LLM_RPM=0
# OpenAI:      LLM_BASE_URL=https://api.openai.com/v1        LLM_MODEL=gpt-4.1             LLM_FALLBACK_MODELS=gpt-4.1-mini     LLM_RPM=0
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=anthropic/claude-sonnet-5.5
# запасные модели при 429 / 5xx / таймауте (через запятую)
LLM_FALLBACK_MODELS=anthropic/claude-sonnet-5,anthropic/claude-opus-5.5
# лимит запросов в минуту на модель (новый аккаунт OpenRouter: 20); 0 — без лимита
LLM_RPM=18
# кэш системного промпта: auto (Claude через OpenRouter) | on | off
LLM_PROMPT_CACHE=auto
PORT=8000
